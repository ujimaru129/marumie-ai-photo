// MARUMIE AI PHOTO の中継サーバー（Cloudflare Workers）
// 2026-11-17 公開済み（https://marumie-ai-photo.332-records.workers.dev）。D1 と R2 は作成済み、R2 の results/ は1日で消えるルールつき。
// APIキー（META_API_KEY・GEMINI_API_KEY）は Cloudflare の画面の「変数とシークレット」で入れる（このファイルには書かない）
{
  "name": "marumie-ai-photo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // 1回の生成で作る枚数（結果画面で選ぶ）と、1回で使うクレジット
    "VARIANTS": "2",
    "CREDITS_PER_GENERATION": "1",
    // 初回の無料生成の回数
    "FREE_GENERATIONS": "1",
    // Muse Image の reasoning_strength（high / low）。失敗したら low でやり直し、それでもだめなら Gemini
    "META_REASONING": "high",
    // テストで差し替えるため（本番はこのまま）
    "META_BASE_URL": "https://api.meta.ai",
    "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "marumie-ai-photo", "database_id": "353d8481-a765-424e-87d1-1c9b162f5666" }
  ],
  "r2_buckets": [
    { "binding": "RESULTS", "bucket_name": "marumie-ai-photo-results" }
  ]
}
